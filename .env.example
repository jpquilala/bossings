# ─────────────────────────────────────────────────────────────
# Bossing's Flying Saucer — environment variables
# Copy to `.env.local` (Next.js) / `.env` (Prisma CLI) and fill in.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Project Settings → API → service_role. SERVER ONLY.
# Bypasses RLS. Used by guest-checkout Server Actions. Never expose.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Database (Prisma) ───────────────────────────────────────
# Project Settings → Database → Connection string.
# DATABASE_URL uses the pooler (port 6543) for app runtime queries.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DIRECT_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Site ────────────────────────────────────────────────────
# Used to build OAuth redirect URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── OpenAI (OPTIONAL — off by default) ──────────────────────
# Master switch for the "Ano ang bagay?" recommender and the free-text order
# parser. While "false" the UI is hidden AND /api/ai/* returns 404, so no
# request can reach OpenAI. Set to "true" once OPENAI_API_KEY is filled in.
NEXT_PUBLIC_AI_ENABLED="false"

# Server only. Never exposed to the browser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-nano"

# ── Redis (OPTIONAL) ────────────────────────────────────────
# Caches the menu and rate-limits the AI routes.
# Leave blank and the app falls back to an in-memory cache automatically.
REDIS_URL=""

# ── Store contact ───────────────────────────────────────────
# Shown on /location and used to build the pre-filled SMS/Messenger order.
NEXT_PUBLIC_STORE_PHONE="09915481541"
NEXT_PUBLIC_MESSENGER_URL="https://m.me/bossingsflyingsaucer"

# ── Sentry (OPTIONAL — off by default) ──────────────────────
# Set NEXT_PUBLIC_SENTRY_ENABLED="true" to switch monitoring on.
NEXT_PUBLIC_SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
